// Vacationdeal — Prisma schema
// SQLite for local development. See .env for DATABASE_URL (file:./dev.db).
//
// NOTE: This project was designed for PostgreSQL. For local development it uses
// SQLite, which does not support native enums or scalar-list (`String[]`) columns.
// Those are therefore modelled as `String`:
//   • enum-typed fields  → String holding one of the documented values.
//   • list fields        → String holding a JSON-encoded array (use the
//                          parseList / serializeList helpers in lib/utils.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Enum value references (stored as String on SQLite)
//
//  UserRole      : SUPER_ADMIN | ADMIN | CONTENT_MANAGER | BOOKING_MANAGER
//  BookingStatus : PENDING | PAYMENT_PENDING | CONFIRMED | IN_PROGRESS |
//                  COMPLETED | CANCELLED | REFUNDED
//  PaymentStatus : PENDING | PAID | FAILED | REFUNDED | PARTIALLY_REFUNDED
//  LeadStatus    : NEW | CONTACTED | FOLLOW_UP | QUALIFIED | CONVERTED | LOST
//  DiscountType  : PERCENTAGE | FIXED
//  PostStatus    : DRAFT | PUBLISHED
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
//  Users & Auth (NextAuth-compatible)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          String    @default("CONTENT_MANAGER")
  image         String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  leadNotes     LeadNote[]
  blogPosts     BlogPost[]
  assignedLeads Lead[]             @relation("LeadAssignee")
  followUps     LeadFollowUp[]     @relation("FollowUpAssignee")
  followUpsMade LeadFollowUp[]     @relation("FollowUpCreator")
  statusChanges LeadStatusChange[] @relation("StatusChangeAuthor")
  documents     SalesDocument[]    @relation("DocumentAuthor")
  activityLogs  ActivityLog[]
  uploads       Media[]            @relation("MediaUploader")

  pagesCreated     Page[]            @relation("PageAuthor")
  pagesUpdated     Page[]            @relation("PageEditor")
  pageRevisions    PageRevision[]    @relation("RevisionAuthor")
  reusableSections ReusableSection[] @relation("ReusableSectionAuthor")
  pageTemplates    PageTemplate[]    @relation("PageTemplateAuthor")

  @@index([role])
  @@index([isActive])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
//  Destinations
// ─────────────────────────────────────────────────────────────

model Destination {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  country           String
  state             String?
  city              String?
  shortDescription  String
  description       String
  coverImage        String?
  bestTimeToVisit   String?
  travelInformation String?
  highlights        String   @default("[]")
  isFeatured        Boolean  @default(false)
  isPublished       Boolean  @default(true)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  images    DestinationImage[]
  packages  TravelPackage[]
  faqs      Faq[]
  blogPosts BlogPost[]         @relation("BlogDestination")
  leads     Lead[]             @relation("LeadDestination")

  @@index([isPublished, isFeatured])
  @@index([country])
  @@index([isPublished, name])
}

model DestinationImage {
  id            String      @id @default(cuid())
  destinationId String
  url           String
  alt           String?
  sortOrder     Int         @default(0)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

// ─────────────────────────────────────────────────────────────
//  Packages
// ─────────────────────────────────────────────────────────────

model PackageCategory {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  isActive    Boolean         @default(true)
  packages    TravelPackage[]
}

model TravelPackage {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  destinationId    String
  categoryId       String?
  shortDescription String
  description      String
  highlights       String   @default("[]")
  durationDays     Int
  durationNights   Int
  startingPrice    Decimal
  discountPrice    Decimal?
  currency         String   @default("INR")
  maxTravellers    Int      @default(20)
  minTravellers    Int      @default(1)
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  bookingEnabled   Boolean  @default(true)
  // JSON-encoded string array — travel types / themes used for related content.
  tags             String   @default("[]")
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  destination Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  category    PackageCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      PackageImage[]
  itinerary   ItineraryDay[]
  inclusions  PackageInclusion[]
  exclusions  PackageExclusion[]
  hotels      PackageHotel[]
  activities  PackageActivity[]
  faqs        Faq[]
  bookings    Booking[]
  reviews     Testimonial[]
  coupons     Coupon[]           @relation("CouponPackages")
  blogPosts   BlogPost[]         @relation("BlogPackage")
  leads       Lead[]             @relation("LeadPackage")

  @@index([published, featured])
  @@index([destinationId])
  @@index([categoryId])
  @@index([published, destinationId])
  @@index([published, startingPrice])
  @@index([createdAt])
}

model PackageImage {
  id        String        @id @default(cuid())
  packageId String
  url       String
  alt       String?
  sortOrder Int           @default(0)
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model ItineraryDay {
  id          String        @id @default(cuid())
  packageId   String
  dayNumber   Int
  title       String
  description String
  activities  String?
  meals       String?
  hotel       String?
  transfers   String?
  sortOrder   Int           @default(0)
  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageInclusion {
  id        String        @id @default(cuid())
  packageId String
  text      String
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageExclusion {
  id        String        @id @default(cuid())
  packageId String
  text      String
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageHotel {
  id          String        @id @default(cuid())
  packageId   String
  name        String
  location    String?
  roomType    String?
  nights      Int           @default(1)
  description String?
  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageActivity {
  id          String        @id @default(cuid())
  packageId   String
  name        String
  description String?
  price       Decimal?
  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

// ─────────────────────────────────────────────────────────────
//  FAQs (reusable across packages / destinations / pages)
// ─────────────────────────────────────────────────────────────

model Faq {
  id            String  @id @default(cuid())
  question      String
  answer        String
  packageId     String?
  destinationId String?
  pageId        String?
  sortOrder     Int     @default(0)
  published     Boolean @default(true)

  package     TravelPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination Destination?   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  page        Page?          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([destinationId])
  @@index([pageId])
}

// ─────────────────────────────────────────────────────────────
//  Customers, Bookings, Payments
// ─────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  whatsapp  String?
  country   String?
  city      String?
  // Digits-only tail of `phone`. Lets a lead be matched to an existing
  // customer by number regardless of how either was typed.
  phoneKey  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  leads     Lead[]    @relation("CustomerLeads")

  @@unique([email, phone])
  @@index([email])
  @@index([phoneKey])
}

model Booking {
  id              String   @id @default(cuid())
  bookingNumber   String   @unique
  customerId      String
  packageId       String
  travelDate      DateTime
  adults          Int      @default(1)
  children        Int      @default(0)
  rooms           Int      @default(1)
  baseAmount      Decimal
  discountAmount  Decimal  @default(0)
  taxAmount       Decimal  @default(0)
  totalAmount     Decimal
  advanceAmount   Decimal  @default(0)
  remainingAmount Decimal  @default(0)
  currency        String   @default("INR")
  couponCode      String?
  status          String   @default("PENDING")
  paymentStatus   String   @default("PENDING")
  specialRequests String?

  // ── Marketing attribution, copied from the same first-touch cookie the
  //    lead form reads, so revenue can be reported by channel. ──
  source      String  @default("DIRECT")
  medium      String?
  campaign    String?
  landingPage String?
  referrer    String?
  gclid       String?
  fbclid      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package  TravelPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([packageId])
  @@index([createdAt])
  @@index([travelDate])
  @@index([paymentStatus, createdAt])
  @@index([status, createdAt])
  @@index([source])
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  amount            Decimal
  currency          String   @default("INR")
  status            String   @default("PENDING")
  paymentMethod     String?
  signature         String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Leads / Enquiries
// ─────────────────────────────────────────────────────────────

model Lead {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String
  whatsapp    String?
  destination String?
  travelDate  DateTime?
  travellers  Int?
  budget      String?
  message     String?
  source      String    @default("website")
  status      String    @default("NEW")
  priority    String    @default("NORMAL")
  country     String?
  returnDate  DateTime?
  adults      Int?
  children    Int?

  // ── Marketing attribution (captured server-side on first touch) ──
  medium      String?
  campaign    String?
  term        String?
  content     String?
  gclid       String?
  fbclid      String?
  landingPage String?
  referrer    String?

  // ── Qualification ──
  // Digits-only tail of `phone`, kept so duplicate detection can match
  // "+91 98765 43210" against "9876543210" with an index rather than a scan.
  phoneKey  String?
  rooms     Int?
  // Honeymoon | Family | Group | Corporate | Solo | Pilgrimage | Adventure
  tripType  String?
  // JSON-encoded string array, same convention as TravelPackage.tags.
  tags      String  @default("[]")
  // Deterministic 0-100 score and its band, recomputed on every change.
  score     Int     @default(0)
  scoreBand String  @default("COLD")

  // ── Interest: what the enquiry is actually about ──
  packageId     String?
  destinationId String?

  // ── Lifecycle ──
  // Set when the lead is converted; the customer it became.
  customerId  String?
  convertedAt DateTime?
  lostReason  String?

  nextFollowUpAt    DateTime?
  lastActivityAt    DateTime?
  assignedToId      String?
  sequenceStage     Int       @default(0)
  sequenceStoppedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  notes          LeadNote[]
  documents      SalesDocument[]
  followUps      LeadFollowUp[]
  statusHistory  LeadStatusChange[]
  assignedTo     User?              @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  package        TravelPackage?     @relation("LeadPackage", fields: [packageId], references: [id], onDelete: SetNull)
  destinationRef Destination?       @relation("LeadDestination", fields: [destinationId], references: [id], onDelete: SetNull)
  customer       Customer?          @relation("CustomerLeads", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([assignedToId])
  @@index([source])
  @@index([priority])
  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([phone])
  @@index([email])
  @@index([phoneKey])
  @@index([customerId])
  @@index([packageId])
  @@index([destinationId])
  @@index([convertedAt])
  @@index([scoreBand, status])
  @@index([status, score])
  @@index([lastActivityAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String
  type      String   @default("NOTE")
  subject   String?
  emailTo   String?
  delivered Boolean  @default(true)
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([leadId, createdAt])
  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

/**
 * A scheduled piece of follow-up work on a lead.
 * `Lead.nextFollowUpAt` stays the authoritative "when is this lead next due"
 * column — every existing filter, counter, dashboard widget and cron job reads
 * it — but it is now *derived*: it always mirrors the earliest PENDING row
 * here. See `syncNextFollowUp` in lib/services/follow-up.ts.
 */
model LeadFollowUp {
  id     String   @id @default(cuid())
  leadId String
  dueAt  DateTime
  // CALL | WHATSAPP | EMAIL | MEETING | TASK
  type   String   @default("CALL")
  title  String
  note   String?
  // PENDING | DONE | CANCELLED
  status String   @default("PENDING")

  assignedToId String?
  createdById  String?

  completedAt DateTime?
  /**
   * What came of it — free text written when the task is closed.
   */
  outcome     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([leadId, status])
  @@index([status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([dueAt])
}

/**
 * Append-only record of every pipeline move, so stage duration and win/loss
 * velocity can be measured instead of guessed. Complements `LeadNote` (which
 * is the human-readable timeline) and `ActivityLog` (which is the audit trail).
 */
model LeadStatusChange {
  id          String   @id @default(cuid())
  leadId      String
  fromStatus  String?
  toStatus    String
  changedById String?
  /**
   * Loss reason, or any note the person gave for the move.
   */
  reason      String?
  createdAt   DateTime @default(now())

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangeAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([toStatus, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Blog CMS
// ─────────────────────────────────────────────────────────────

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  coverImage     String?
  tags           String    @default("[]")
  status         String    @default("DRAFT")
  featured       Boolean   @default(false)
  categoryId     String?
  authorId       String?
  // Optional editorial links used by the internal-linking engine.
  destinationId  String?
  packageId      String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category    BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  destination Destination?   @relation("BlogDestination", fields: [destinationId], references: [id], onDelete: SetNull)
  package     TravelPackage? @relation("BlogPackage", fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status, featured])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([destinationId])
  @@index([packageId])
  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────
//  Testimonials / Reviews
// ─────────────────────────────────────────────────────────────

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  image        String?
  rating       Int      @default(5)
  review       String
  packageId    String?
  destination  String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  package TravelPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([published])
}

// ─────────────────────────────────────────────────────────────
//  Coupons
// ─────────────────────────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE")
  discountAmount Decimal
  minAmount      Decimal?
  maxDiscount    Decimal?
  startDate      DateTime?
  expiryDate     DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  packages TravelPackage[] @relation("CouponPackages")

  @@index([active])
}

// ─────────────────────────────────────────────────────────────
//  Media library
// ─────────────────────────────────────────────────────────────

model Media {
  id               String   @id @default(cuid())
  url              String
  filename         String
  originalFilename String?
  mimeType         String
  size             Int
  alt              String?
  title            String?
  caption          String?
  folder           String   @default("general")
  // Provider-specific handle used to delete the object again
  // ("local" paths, a Vercel Blob URL, or an S3/R2 object key).
  storageProvider  String   @default("local")
  storageKey       String?
  width            Int?
  height           Int?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  createdBy User? @relation("MediaUploader", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([mimeType])
  @@index([folder])
  @@index([createdAt])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────
//  CMS Pages (about, terms, etc.)
// ─────────────────────────────────────────────────────────────

model Page {
  id             String  @id @default(cuid())
  title          String
  slug           String  @unique
  // Legacy rendering path, kept so pages built before the page builder keep
  // working. A page with builder content ignores these two columns.
  content        String
  sections       String?
  status         String  @default("PUBLISHED")
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // ── Page builder ──
  // The draft is what the builder edits; the published copy is what visitors
  // see. Publishing copies one into the other, so editing a page never
  // changes the live version until it is published.
  draftContent     Json?
  publishedContent Json?
  /// Page template this page started from, e.g. "homepage" or "landing".
  template         String?
  publishedAt      DateTime?
  createdById      String?
  updatedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs      Faq[]
  revisions PageRevision[]
  createdBy User?          @relation("PageAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("PageEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([updatedAt])
  @@index([template])
  @@index([createdById])
  @@index([updatedById])
}

// ─────────────────────────────────────────────────────────────
//  Page builder — revisions, reusable sections and templates
// ─────────────────────────────────────────────────────────────

/// A snapshot of a page's builder content. Written on publish and on manual
/// save, so an editor can look at what a page used to be and put it back.
/// Never written per keystroke.
model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  content     Json
  /// "autosave" | "manual" | "publish" | "restore"
  reason      String   @default("manual")
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  page      Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User? @relation("RevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
  @@index([createdById])
}

/// A section saved once and used on many pages. A page referencing one stores
/// only its id, so editing the shared section updates every page using it.
model ReusableSection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  content     Json
  status      String   @default("PUBLISHED")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  createdBy User? @relation("ReusableSectionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([updatedAt])
  @@index([createdById])
}

/// A starting point: either a whole page layout or a single section, saved to
/// the template library and inserted into other pages.
model PageTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// "page" | "section"
  kind        String   @default("section")
  /// Groups templates in the picker, e.g. "Hero", "Travel".
  category    String   @default("General")
  content     Json
  /// Shipped with the product and not deletable from the UI.
  isBuiltIn   Boolean  @default(false)
  thumbnail   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  createdBy User? @relation("PageTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([category])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────
//  Site settings (single-row key/value config)
// ─────────────────────────────────────────────────────────────

model SiteSetting {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Sales documents — quotations and invoices share one shape
// ─────────────────────────────────────────────────────────────

model SalesDocument {
  id     String @id @default(cuid())
  kind   String @default("QUOTATION")
  number String @unique
  status String @default("DRAFT")

  leadId      String?
  bookingId   String?
  createdById String?

  customerName   String
  customerEmail  String?
  customerPhone  String?
  billingAddress String?

  title       String?
  destination String?
  travelDate  DateTime?
  travellers  Int?
  validUntil  DateTime?
  dueDate     DateTime?

  currency   String  @default("INR")
  discount   Decimal @default(0)
  taxPercent Decimal @default(0)
  amountPaid Decimal @default(0)

  notes String?
  terms String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     SalesDocumentItem[]
  lead      Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("DocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([status])
  @@index([leadId])
  @@index([createdAt])
}

model SalesDocumentItem {
  id          String  @id @default(cuid())
  documentId  String
  title       String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0)
  sortOrder   Int     @default(0)

  document SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Redirect {
  id         String   @id @default(cuid())
  source     String   @unique
  target     String
  // `permanent` is kept for backward compatibility with existing rows;
  // `statusCode` is authoritative (301 | 302 | 307 | 308).
  permanent  Boolean  @default(true)
  statusCode Int      @default(301)
  hits       Int      @default(0)
  isActive   Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
//  Admin activity / audit log
//
//  Every privileged mutation writes one row here. Rows are append-only:
//  nothing in the application updates or deletes them.
// ─────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  // Denormalised so the log still reads correctly after a user is deleted.
  userName    String?
  userRole    String?
  // LOGIN | LOGOUT | CREATE | UPDATE | DELETE | STATUS_CHANGE | PAYMENT |
  // ASSIGN | UPLOAD | EXPORT | SETTINGS
  action      String
  // "Booking", "Lead", "TravelPackage", "Media", …
  entity      String
  entityId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Reusable SEO metadata
//
//  Attached polymorphically to any indexable record (entityType +
//  entityId) so SEO controls can be added to new content types without
//  widening every content table. Legacy `seoTitle` / `seoDescription`
//  columns on the content models keep working as the fallback.
// ─────────────────────────────────────────────────────────────

model SeoMeta {
  id         String @id @default(cuid())
  // PACKAGE | DESTINATION | BLOG | PAGE | ROUTE
  entityType String
  // The record id, or the pathname for entityType = ROUTE.
  entityId   String

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  focusKeyword   String?

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?

  robotsIndex  Boolean @default(true)
  robotsFollow Boolean @default(true)

  // Extra JSON-LD emitted alongside the generated schema. `schemaType` is
  // informational; `schemaJson` must be a valid JSON-LD object or array.
  schemaType String?
  schemaJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([robotsIndex])
}
