# ─────────────────────────────────────────────────────────────
#  Vacationdeal — Environment Configuration
#  Copy this file to `.env` and fill in real values.
#  Never commit `.env` — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) — REQUIRED ─────────────────────────
# Local:  postgresql://USER:PASSWORD@localhost:5432/vacationdeal?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/vacationdeal?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vacationdeal?schema=public"

# ── Auth (NextAuth / Auth.js) — REQUIRED ─────────────────────
# Generate: `openssl rand -base64 32`  (or `npx auth secret`)
# Also signs the customer-portal cookie, so changing it signs everyone out.
AUTH_SECRET="replace-with-a-long-random-string"
# Full canonical URL of the site. Required on any host that is not Vercel.
NEXTAUTH_URL="http://localhost:3000"

# ── Canonical site URL — REQUIRED in production ──────────────
# Used for canonical tags, Open Graph URLs, the sitemap and email links.
# No trailing slash. Getting this wrong points every canonical at localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed admin (used only by prisma/seed.ts) ─────────────────
SEED_ADMIN_EMAIL="admin@vacationdeal.test"
SEED_ADMIN_PASSWORD="Admin@12345"

# ── Razorpay (test mode works with test keys) ────────────────
# Keys: https://dashboard.razorpay.com/app/keys
# Without these, checkout falls back to "enquiry" mode instead of breaking.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set this in the Razorpay dashboard when you add the webhook endpoint
# (/api/payments/webhook). Webhooks are rejected without it.
RAZORPAY_WEBHOOK_SECRET=""
# The public key id is sent to the browser checkout script — it is not a secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── SMTP / Email (Nodemailer) ────────────────────────────────
# Without SMTP the app still works; emails are skipped and logged.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Vacationdeal <bookings@vacationdeal.test>"
# Where internal notifications (new lead / new booking) are sent
ADMIN_NOTIFY_EMAIL="admin@vacationdeal.test"

# ── WhatsApp ─────────────────────────────────────────────────
# International format, digits only, e.g. 919876543210.
# The value saved in Admin → Settings takes priority over this.
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# ── Scheduled CRM jobs ───────────────────────────────────────
# Protects /api/cron/crm. In production the endpoint returns 503 until this
# is set. Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET=""

# ── Media storage ────────────────────────────────────────────
# local | vercel-blob | s3
# "local" writes to /public/uploads — fine for development, but a serverless
# host wipes the filesystem on every deploy, so production needs one of the
# other two. Leave STORAGE_DRIVER unset and the driver is inferred from
# whichever credentials below are present.
STORAGE_DRIVER="local"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# S3-compatible (AWS S3, Cloudflare R2, Backblaze B2, MinIO…)
S3_BUCKET=""
S3_REGION="auto"
# R2: https://<account-id>.r2.cloudflarestorage.com
# AWS: leave empty to use https://s3.<region>.amazonaws.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL the stored objects are served from, e.g. https://cdn.example.com
S3_PUBLIC_URL=""

# ── Testing ──────────────────────────────────────────────────
# Set to "true" only in test runs — it disables rate limiting.
RATE_LIMIT_DISABLED=""
