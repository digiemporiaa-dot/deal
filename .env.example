# ─────────────────────────────────────────────────────────────
#  Vacationdeal — Environment Configuration
#  Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) -----------------------------------
# Local:  postgresql://USER:PASSWORD@localhost:5432/vacationdeal?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/vacationdeal?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vacationdeal?schema=public"

# --- Auth (NextAuth / Auth.js) -------------------------------
# Generate: `openssl rand -base64 32`  (or `npx auth secret`)
AUTH_SECRET="replace-with-a-long-random-string"
# Full canonical URL of the site (used by NextAuth + SEO/sitemap)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed admin (used only by prisma/seed.ts) ----------------
SEED_ADMIN_EMAIL="admin@vacationdeal.test"
SEED_ADMIN_PASSWORD="Admin@12345"

# --- Razorpay (test mode works with test keys) ---------------
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Public key id is exposed to the browser checkout script
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- SMTP / Email (Nodemailer) -------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Vacationdeal <bookings@vacationdeal.test>"
# Where internal notifications (new lead / booking) are sent
ADMIN_NOTIFY_EMAIL="admin@vacationdeal.test"

# --- WhatsApp ------------------------------------------------
# International format, digits only, e.g. 919876543210 (fallback; DB settings override)
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# --- Image storage (optional Vercel Blob) --------------------
# If unset, admin media upload stores files under /public/uploads (local dev).
BLOB_READ_WRITE_TOKEN=""
